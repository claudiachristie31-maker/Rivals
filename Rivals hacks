closeButton.Activated:Connect(function()
    panel.Visible = false
    openButton.Visible = true
end)

-- Feature controls
makeToggle("ESP", 55, espEnabled, function(value)
    espEnabled = value
    for _, other in ipairs(Players:GetPlayers()) do
        updatePlayer(other)
        local data = tracked[other]
        if data and data.highlight then
            data.highlight.Enabled = espEnabled or chamsEnabled
        end
    end
end)

makeToggle("CHAMS", 108, chamsEnabled, function(value)
    chamsEnabled = value
    for _, other in ipairs(Players:GetPlayers()) do
        updatePlayer(other)
        local data = tracked[other]
        if data and data.highlight then
            data.highlight.Enabled = espEnabled or chamsEnabled
            -- Occluded mode keeps highlights hidden behind walls.
        end
    end
end)

makeToggle("NAMES", 161, namesEnabled, function(value)
    namesEnabled = value
    for _, other in ipairs(Players:GetPlayers()) do
        updatePlayer(other)
        local data = tracked[other]
        if data and data.billboard then
            data.billboard.Enabled = namesEnabled
        end
    end
end)

-- Track players and respawns
local function trackPlayer(other)
    if other == localPlayer then return end

    other.CharacterAdded:Connect(function()
        task.wait(0.5)
        updatePlayer(other)
    end)

    if other.Character then
        updatePlayer(other)
    end
end

for _, other in ipairs(Players:GetPlayers()) do
    trackPlayer(other)
end

Players.PlayerAdded:Connect(trackPlayer)
Players.PlayerRemoving:Connect(removeVisuals)

-- Keep visuals synchronized
task.spawn(function()
    while gui.Parent do
        for _, other in ipairs(Players:GetPlayers()) do
            if other ~= localPlayer then
                updatePlayer(other)
                local data = tracked[other]
                if data then
                    data.highlight.Enabled = espEnabled or chamsEnabled
                    if data.billboard then
                        data.billboard.Enabled = namesEnabled
                    end
                end
            end
        end
        task.wait(0.5)
    end
end)

script.Destroying:Connect(function()
    for other in pairs(tracked) do
        removeVisuals(other)
    end
    gui:Destroy()
end)
