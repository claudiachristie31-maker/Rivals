-- Drag support: mouse and touchscreen
local dragging = false
local dragStart
local startPosition
local dragInput

title.Active = true

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = frame.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

title.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (
        input == dragInput
        or input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

-- Feature buttons
local states = {
    ESP = false,
    CHAMS = false,
    NAMES = false,
    ["HEAD TARGET"] = false,
    ["AUTO SHOOT"] = false,
}

local buttons = {}
local features = {
    "ESP",
    "CHAMS",
    "NAMES",
    "HEAD TARGET",
    "AUTO SHOOT",
}

for i, feature in ipairs(features) do
    local button = Instance.new("TextButton")
    button.Name = feature:gsub(" ", "") .. "Button"
    button.Size = UDim2.new(1, -20, 0, 38)
    button.Position = UDim2.new(0, 10, 0, 35 + (i - 1) * 45)
    button.Text = feature .. ": OFF"
    button.Parent = frame
    buttons[feature] = button

    button.MouseButton1Click:Connect(function()
        states[feature] = not states[feature]
        button.Text = feature .. ": "
            .. (states[feature] and "ON" or "OFF")
    end)
end

-- Nearest NPC for your own game's auto-shoot system
local GUN_NAME = "Gun"
local RANGE = 100
local FIRE_INTERVAL = 0.2
local elapsed = 0

local function getNearestNPC(maxDistance)
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local nearest
    local nearestDistance = maxDistance

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model")
            and not Players:GetPlayerFromCharacter(obj) then

            local humanoid = obj:FindFirstChildOfClass("Humanoid")
            local npcRoot = obj:FindFirstChild("HumanoidRootPart")

            if humanoid and humanoid.Health > 0 and npcRoot then
                local distance = (npcRoot.Position - root.Position).Magnitude

                if distance < nearestDistance then
                    nearest = obj
                    nearestDistance = distance
                end
            end
        end
    end

    return nearest
end

RunService.Heartbeat:Connect(function(dt)
    if not states["AUTO SHOOT"] then return end

    elapsed += dt
    if elapsed < FIRE_INTERVAL then return end
    elapsed = 0

    local character = player.Character
    local gun = character and character:FindFirstChild(GUN_NAME)

    if gun and gun:IsA("Tool") and getNearestNPC(RANGE) then
        gun:Activate()
    end
end)

-- Nearest head selection
local selectedHead

buttons["HEAD TARGET"].MouseButton1Click:Connect(function()
    if not states["HEAD TARGET"] then
        selectedHead = nil
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local nearestDistance = 250
    selectedHead = nil

    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local targetCharacter = targetPlayer.Character
            local head = targetCharacter and targetCharacter:FindFirstChild("Head")
            local humanoid = targetCharacter
                and targetCharacter:FindFirstChildOfClass("Humanoid")

            if head and humanoid and humanoid.Health > 0 then
                local distance = (head.Position - root.Position).Magnitude

                if distance < nearestDistance then
                    nearestDistance = distance
                    selectedHead = head
                end
            end
        end
    end

    buttons["HEAD TARGET"].Text = selectedHead
        and ("TARGET: " .. selectedHead.Parent.Name)
        or "HEAD TARGET: NONE"
end)

-- Visual effects for your own game
local function refreshVisuals()
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local character = targetPlayer.Character

            if character then
                local highlight = character:FindFirstChild("NickoyHighlight")

                if states.ESP or states.CHAMS then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "NickoyHighlight"
                        highlight.Adornee = character
                        highlight.DepthMode = Enum.HighlightDepthMode.Occluded
                        highlight.Parent = character
                    end

                    highlight.Enabled = true
                    highlight.FillColor = states.CHAMS
                        and Color3.fromRGB(255, 80, 80)
                        or Color3.fromRGB(80, 170, 255)
                elseif highlight then
                    highlight:Destroy()
                end

                local head = character:FindFirstChild("Head")
                if head then
                    local tag = head:FindFirstChild("NickoyNameTag")

                    if states.NAMES then
                        if not tag then
                            tag = Instance.new("BillboardGui")
                            tag.Name = "NickoyNameTag"
                            tag.Size = UDim2.fromOffset(160, 30)
                            tag.StudsOffset = Vector3.new(0, 2, 0)
                            tag.AlwaysOnTop = true
                            tag.Adornee = head
                            tag.Parent = head

                            local label = Instance.new("TextLabel")
                            label.Name = "NameLabel"
                            label.Size = UDim2.fromScale(1, 1)
                            label.BackgroundTransparency = 1
                            label.TextColor3 = Color3.new(1, 1, 1)
                            label.TextScaled = true
                            label.Parent = tag
                        end

                        tag.NameLabel.Text = targetPlayer.Name
                    elseif tag then
                        tag:Destroy()
                    end
                end
            end
        end
    end
end

while gui.Parent do
    task.wait(0.5)
    refreshVisuals()
end
