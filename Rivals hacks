-- Drag support: mouse and touch
local dragging = false
local dragStart
local startPosition
local activeTouch

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = frame.Position

        if input.UserInputType == Enum.UserInputType.Touch then
            activeTouch = input
        end
    end
end)

UIS.InputChanged:Connect(function(input)
    if not dragging then
        return
    end

    local mouseMove =
        input.UserInputType == Enum.UserInputType.MouseMovement

    local touchMove =
        input.UserInputType == Enum.UserInputType.Touch
        and input == activeTouch

    if mouseMove or touchMove then
        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or (input.UserInputType == Enum.UserInputType.Touch
        and input == activeTouch) then

        dragging = false
        activeTouch = nil
    end
end)

-- Button helpers
local function updateButton(feature, customText)
    local button = buttons[feature]
    if not button then
        return
    end

    button.Text = customText
        or (feature .. ": " .. (states[feature] and "ON" or "OFF"))

    button.BackgroundColor3 = states[feature]
        and Color3.fromRGB(45, 115, 75)
        or Color3.fromRGB(55, 55, 55)
end

-- Find nearest living player's head
local function getNearestOpponentHead()
    local character = player.Character
    local root = character
        and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return nil
    end

    local nearestHead = nil
    local nearestDistance = TARGET_RANGE

    for _, opponent in ipairs(Players:GetPlayers()) do
        if opponent ~= player then
            local model = opponent.Character
            local humanoid = model
                and model:FindFirstChildOfClass("Humanoid")
            local head = model and model:FindFirstChild("Head")
            local opponentRoot =
                model and model:FindFirstChild("HumanoidRootPart")

            if humanoid and humanoid.Health > 0
                and head and opponentRoot then

                local distance =
                    (opponentRoot.Position - root.Position).Magnitude

                if distance < nearestDistance then
                    nearestDistance = distance
                    nearestHead = head
                end
            end
        end
    end

    return nearestHead
end

-- Feature buttons
for i, feature in ipairs(features) do
    local button = Instance.new("TextButton")
    button.Name = feature:gsub(" ", "") .. "Button"
    button.Size = UDim2.new(1, -20, 0, 40)
    button.Position = UDim2.new(0, 10, 0, 38 + (i - 1) * 47)
    button.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.BorderSizePixel = 0
    button.Text = feature .. ": OFF"
    button.Parent = frame

    buttons[feature] = button

    button.MouseButton1Click:Connect(function()
        states[feature] = not states[feature]

        if feature == "HEAD TARGET" then
            if states[feature] then
                targetHead = getNearestOpponentHead()

                if targetHead then
                    updateButton(
                        feature,
                        "TARGET: " .. targetHead.Parent.Name
                    )
                else
                    states[feature] = false
                    updateButton(feature, "HEAD TARGET: NO PLAYER")
                end
            else
                targetHead = nil
                updateButton(feature, "HEAD TARGET: OFF")
            end
        else
            updateButton(feature)
        end
    end)
end

