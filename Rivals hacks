slider.TextColor3 = Color3.new(1, 1, 1)
slider.TextScaled = true
slider.Parent = panel

Instance.new("UICorner", slider).CornerRadius = UDim.new(0, 8)

local function getNearestPlayer()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local nearest, nearestDistance = nil, 250

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= player then
            local char = other.Character
            local head = char and char:FindFirstChild("Head")
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")

            if head and humanoid and humanoid.Health > 0 then
                local distance = (head.Position - root.Position).Magnitude

                if distance < nearestDistance then
                    nearestDistance = distance
                    nearest = other
                end
            end
        end
    end

    return nearest
end

toggle.Activated:Connect(function()
    enabled = not enabled
    toggle.Text = enabled and "HEAD AIM: ON" or "HEAD AIM: OFF"
    toggle.BackgroundColor3 = enabled
        and Color3.fromRGB(120, 65, 180)
        or Color3.fromRGB(75, 55, 105)

    if not enabled then
        targetPlayer = nil
        status.Text = "Target: None"
    end
end)

-- Tap slider to cycle smoothness
slider.Activated:Connect(function()
    smoothness = smoothness + 0.15
    if smoothness > 0.8 then
        smoothness = 0.05
    end

    sliderLabel.Text = "Smoothness: "
        .. math.floor(smoothness * 100) .. "%"
end)

RunService:BindToRenderStep(
    "NickoyHeadAim",
    Enum.RenderPriority.Camera.Value + 1,
    function()
        if not enabled then return end

        local camera = workspace.CurrentCamera
        if not camera then return end

        if not targetPlayer
            or not targetPlayer.Character
            or not targetPlayer.Character:FindFirstChild("Head")
            or not targetPlayer.Character:FindFirstChildOfClass("Humanoid")
            or targetPlayer.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then
            targetPlayer = getNearestPlayer()
        end

        local head = targetPlayer
            and targetPlayer.Character
            and targetPlayer.Character:FindFirstChild("Head")

        if not head then
            status.Text = "Target: None"
            return
        end

        status.Text = "Target: " .. targetPlayer.DisplayName

        local desired = CFrame.lookAt(
            camera.CFrame.Position,
            head.Position
        )

        camera.CFrame = camera.CFrame:Lerp(
            desired,
            math.clamp(smoothness, 0.05, 1)
        )
    end
)

script.Destroying:Connect(function()
    RunService:UnbindFromRenderStep("NickoyHeadAim")
    gui:Destroy()
end)
