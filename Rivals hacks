-- Toggle buttons
local function makeToggle(text, y, initialState, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -24, 0, 45)
    button.Position = UDim2.fromOffset(12, y)
    button.BackgroundColor3 = Color3.fromRGB(65, 55, 85)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextScaled = true
    button.Font = Enum.Font.GothamBold
    button.Parent = panel
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)

    local state = initialState

    local function refresh()
        button.Text = text .. ": " .. (state and "ON" or "OFF")
        button.BackgroundColor3 = state
            and Color3.fromRGB(115, 65, 165)
            or Color3.fromRGB(65, 55, 85)
    end

    button.Activated:Connect(function()
        state = not state
        refresh()
        callback(state)
    end)

    refresh()
    return button
end

-- Player visuals
local function removeVisuals(other)
    local data = tracked[other]
    if not data then return end

    if data.highlight then
        data.highlight:Destroy()
    end

    if data.billboard then
        data.billboard:Destroy()
    end

    tracked[other] = nil
end

local function updatePlayer(other)
    if other == localPlayer then return end

    local character = other.Character
    if not character then
        removeVisuals(other)
        return
    end

    if not tracked[other] or tracked[other].character ~= character then
        removeVisuals(other)

        local highlight = Instance.new("Highlight")
        highlight.Name = "NickoyHighlight"
        highlight.Adornee = character
        highlight.FillColor = Color3.fromRGB(170, 80, 255)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.Occluded
        highlight.Enabled = false
        highlight.Parent = character

        local head = character:FindFirstChild("Head")
        local billboard

        if head then
            billboard = Instance.new("BillboardGui")
            billboard.Name = "NickoyNameTag"
            billboard.Adornee = head
            billboard.Size = UDim2.fromOffset(180, 35)
            billboard.StudsOffset = Vector3.new(0, 2.5, 0)
            billboard.AlwaysOnTop = false
            billboard.Enabled = false
            billboard.Parent = playerGui

            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.fromScale(1, 1)
            nameLabel.BackgroundTransparency = 1
            nameLabel.TextColor3 = Color3.fromRGB(220, 180, 255)
            nameLabel.TextStrokeTransparency = 0.25
            nameLabel.TextScaled = true
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.Text = other.DisplayName
            nameLabel.Parent = billboard
        end

        tracked[other] = {
            character = character,
            highlight = highlight,
            billboard = billboard
        }
    end

    local data = tracked[other]
    if data then
        data.highlight.Enabled = chamsEnabled
        if data.billboard then
            data.billboard.Enabled = namesEnabled
        end
    end
end

-- Open and close menu
openButton.Activated:Connect(function()
    panel.Visible = true
