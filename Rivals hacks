-- Draggable title bar: mouse and touch
local dragging = false
local dragStart
local startPosition
local activeTouch

title.Active = true

title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = frame.Position

        if input.UserInputType == Enum.UserInputType.Touch then
            activeTouch = input
        end
    end
end)

UIS.InputChanged:Connect(function(input)
    if not dragging then
        return
    end

    local isMouse =
        input.UserInputType == Enum.UserInputType.MouseMovement

    local isTouch =
        input.UserInputType == Enum.UserInputType.Touch
        and input == activeTouch

    if isMouse or isTouch then
        local delta = input.Position - dragStart

        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or (input.UserInputType == Enum.UserInputType.Touch
        and input == activeTouch) then

        dragging = false
        activeTouch = nil
    end
end)

-- Feature states
local states = {
    ESP = false,
    CHAMS = false,
    NAMES = false,
    ["HEAD TARGET"] = false,
    ["AUTO SHOOT"] = false,
}

local buttons = {}

local features = {
    "ESP",
    "CHAMS",
    "NAMES",
    "HEAD TARGET",
    "AUTO SHOOT",
}

local function updateButton(feature, customText)
    local button = buttons[feature]
    if not button then
        return
    end

    button.Text = customText or (
        feature .. ": " .. (states[feature] and "ON" or "OFF")
    )

    button.BackgroundColor3 = states[feature]
        and Color3.fromRGB(45, 115, 75)
        or Color3.fromRGB(55, 55, 55)
end

-- Find the nearest eligible living player's head
local function getNearestOpponentHead()
    local character = player.Character
    local root = character
        and character:FindFirstChild("HumanoidRootPart")

    if not root then
        return nil
    end

    local nearestHead = nil
    local nearestDistance = TARGET_RANGE

    for _, opponent in ipairs(Players:GetPlayers()) do
        if opponent ~= player then
            local opponentCharacter = opponent.Character
            local humanoid = opponentCharacter
                and opponentCharacter:FindFirstChildOfClass("Humanoid")
            local head = opponentCharacter
                and opponentCharacter:FindFirstChild("Head")
            local opponentRoot = opponentCharacter
                and opponentCharacter:FindFirstChild("HumanoidRootPart")

            -- Add your own game's team/match eligibility checks here.
            if humanoid and humanoid.Health > 0
                and head and opponentRoot then

                local distance =
                    (opponentRoot.Position - root.Position).Magnitude

                if distance < nearestDistance then
                    nearestDistance = distance
                    nearestHead = head
                end
            end
        end
    end

    return nearestHead
end

-- Create feature buttons
for i, feature in ipairs(features) do
    local button = Instance.new("TextButton")
    button.Name = feature:gsub(" ", "") .. "Button"
    button.Size = UDim2.new(1, -20, 0, 38)
    button.Position = UDim2.new(0, 10, 0, 35 + (i - 1) * 45)
    button.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.BorderSizePixel = 0
    button.Text = feature .. ": OFF"
    button.Parent = frame

    buttons[feature] = button

    button.MouseButton1Click:Connect(function()
        states[feature] = not states[feature]

        if feature == "HEAD TARGET" then
            if states[feature] then
                targetHead = getNearestOpponentHead()

                if targetHead then
                    updateButton(
                        feature,
                        "TARGET: " .. targetHead.Parent.Name
                    )
                else
                    updateButton(feature, "HEAD TARGET: NO PLAYER")
                end
            else
                targetHead = nil
                updateButton(feature, "HEAD TARGET: OFF")
            end
        else
            updateButton(feature)
        end
    end)
end

-- Clear the selected head if it disappears or the player leaves
Players.PlayerRemoving:Connect(function(leavingPlayer)
    if targetHead and targetHead:IsDescendantOf(
        leavingPlayer.Character or Instance.new("Folder")
    ) then
        targetHead = nil
        states["HEAD TARGET"] = false
        updateButton("HEAD TARGET", "HEAD TARGET: OFF")
    end
end)

-- ESP / CHAMS / NAMES visual updates
local function refreshVisuals()
    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        if targetPlayer ~= player then
            local character = targetPlayer.Character

            if character then
                local highlight =
                    character:FindFirstChild("NickoyHighlight")

                if states.ESP or states.CHAMS then
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "NickoyHighlight"
                        highlight.Adornee = character
                        highlight.DepthMode =
                            Enum.HighlightDepthMode.Occluded
                        highlight.Parent = character
                    end

                    highlight.Enabled = true
                    highlight.FillColor = states.CHAMS
                        and Color3.fromRGB(255, 80, 80)
                        or Color3.fromRGB(80, 170, 255)
                elseif highlight then
                    highlight:Destroy()
                end

                local head = character:FindFirstChild("Head")

                if head then
                    local tag = head:FindFirstChild("NickoyNameTag")

                    if states.NAMES then
                        if not tag then
                            tag = Instance.new("BillboardGui")
                            tag.Name = "NickoyNameTag"
                            tag.Size = UDim2.fromOffset(160, 30)
                            tag.StudsOffset = Vector3.new(0, 2, 0)
                            tag.AlwaysOnTop = true
                            tag.Adornee = head
                            tag.Parent = head

                            local label = Instance.new("TextLabel")
                            label.Name = "NameLabel"
                            label.Size = UDim2.fromScale(1, 1)
                            label.BackgroundTransparency = 1
                            label.TextColor3 = Color3.new(1, 1, 1)
                            label.TextScaled = true
                            label.Parent = tag
                        end

                        tag.NameLabel.Text = targetPlayer.Name
                    elseif tag then
                        tag:Destroy()
                    end
                end
            end
        end
    end
end

